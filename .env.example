# Venue Integrity Audit — example environment. Copy to .env and edit.
# Never commit real keys. All values below are placeholders.

# Operating mode. The audit service only supports replay/simulation; it has no
# order-entry path and refuses to start in any other mode.
VIA_MODE=replay

# Configuration directory (settings.yaml, fix_dictionary.yaml, venue_registry.yaml, ...)
VIA_CONFIG_DIR=./config

# Raw event store (SQLite file for the prototype; PostgreSQL schema in database/schema.sql)
VIA_RAW_STORE_PATH=./audit_output/raw_events.sqlite

# API keys: JSON list of {key, principal, roles}. Roles: reader, ingestor, admin, approver.
# Maker-checker: a mapping change proposed by one principal must be approved by another.
VIA_API_KEYS=[{"key":"change-me-reader","principal":"analyst","roles":["reader"]},{"key":"change-me-ingest","principal":"ingest-svc","roles":["ingestor"]},{"key":"change-me-admin","principal":"refdata-maker","roles":["admin","reader"]},{"key":"change-me-approver","principal":"refdata-checker","roles":["approver","reader"]}]

# Requests per minute per principal
VIA_RATE_LIMIT_PER_MINUTE=600

# PostgreSQL (docker-compose)
POSTGRES_USER=via_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=venue_integrity

# Optional: run the PostgreSQL schema test (tests/database) against this DSN
# VIA_TEST_PG_DSN=postgresql://via_admin:change-me@localhost:5432/venue_integrity_test
