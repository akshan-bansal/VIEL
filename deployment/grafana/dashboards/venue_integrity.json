{
  "title": "Venue Integrity Monitor",
  "uid": "venue-integrity",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Unresolved venue events",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(via_unresolved_exceptions{exception_type=~\"UNKNOWN_DESTINATION|AMBIGUOUS_VENUE|INVALID_VENUE|UNRESOLVED_EXECUTION_VENUE\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Mapping coverage",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "via_mapping_coverage_ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Execution reconciliation (lineage)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "via_execution_lineage_ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Silent coercions (required: 0)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "via_silent_coercions + via_silent_venue_fallbacks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Market-order classification",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "via_market_orders_classified",
          "refId": "A",
          "legendFormat": "{{classification}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Unmapped destination volume",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "via_unmapped_destination_volume",
          "refId": "A",
          "legendFormat": "unmapped qty"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Data-quality exceptions over time",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (exception_type) (via_unresolved_exceptions)",
          "refId": "A",
          "legendFormat": "{{exception_type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Alerts by code",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "via_alerts",
          "refId": "A",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Actual venue attribution",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "via_actual_venue_attribution_ratio",
          "refId": "A",
          "legendFormat": "attributed share"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Historical mapping changes",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "via_registry_version_info",
          "refId": "A",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Open sequence gaps",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "via_sequence_gaps_open",
          "refId": "A",
          "legendFormat": "missing seq numbers"
        }
      ]
    }
  ],
  "description": "Spec \u00a713.1 dashboard. Venue influence vs adverse selection, actual vs intended venue and SOR decision vs outcome are served by /analytics/* and the audit evidence package."
}
